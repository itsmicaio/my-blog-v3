---
import { tagLabel } from '../lib/posts';

interface Props {
  tags: readonly string[];
  maxTags?: number;
  /** `terminal` is the home page card treatment; post pages keep the default pills. */
  variant?: 'pill' | 'terminal';
}

const { tags, maxTags, variant = 'pill' } = Astro.props;

const shown = maxTags === undefined ? tags : tags.slice(0, maxTags);
const overflow = maxTags !== undefined && tags.length > maxTags ? tags.length - maxTags : 0;
---

{variant === 'pill' ? (
  <div class="flex items-center gap-2">
    {shown.map((tag) => (
      <span
        class="group-hover:bg-green group-hover:text-gray-200 rounded-md bg-gray-600 p-1 text-xs font-bold text-white hover:bg-black"
        aria-label={`Tag ${tag}`}
      >
        {tagLabel(tag)}
      </span>
    ))}
    {overflow > 0 && <span>+{overflow}</span>}
  </div>
) : (
  <div class="chips">
    {shown.map((tag) => (
      <span class="chip" aria-label={`Tag ${tag}`}>
        <span class="caret" aria-hidden="true">
          &gt;
        </span>
        {tagLabel(tag)}
      </span>
    ))}
    {overflow > 0 && <span class="chip overflow">+{overflow}</span>}
  </div>
)}

{/* No <style> here on purpose: a scoped block would make Astro emit this
    component's CSS and its data-astro-cid attributes onto post pages too, which
    render the pill variant. The terminal chips are styled by PostCard instead. */}

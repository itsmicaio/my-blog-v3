---
import TagList from './TagList.astro';
import { excerpt, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="news:px-0 group mb-2 w-full px-4 font-thin hover:bg-gray-200">
  <a class="block py-4" href={`/post/${post.id}/`}>
    <div class="news:flex-row flex flex-col">
      <h2 class="group-hover:text-green mr-2 text-lg font-semibold">
        {post.data.title}
        {post.data.draft && <span class="ml-2 text-xs">(rascunho)</span>}
      </h2>
      <TagList tags={post.data.tags} maxTags={3} />
    </div>
    <p class="group-hover:text-green mt-2 mb-0 text-sm leading-5">{excerpt(post)}</p>
  </a>
</li>

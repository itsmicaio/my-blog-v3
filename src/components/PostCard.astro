---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<li class="py-5">
  <a href={`/blog/${post.id}/`} class="group block">
    <h3 class="group-hover:text-accent font-medium transition-colors">
      {post.data.title}
      {post.data.draft && <span class="text-ink-muted ml-2 text-xs">(rascunho)</span>}
    </h3>
    <p class="text-ink-muted mt-1 line-clamp-2 text-sm">{post.data.description}</p>
    <time datetime={post.data.pubDate.toISOString()} class="text-ink-muted mt-2 block text-xs">
      {formatDate(post.data.pubDate)}
    </time>
  </a>
</li>

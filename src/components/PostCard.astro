---
import TagList from './TagList.astro';
import { excerpt, isoDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Ordinal counted from the oldest listed post; the caller owns the numbering. */
  number: number;
}

const { post, number } = Astro.props;
const minutes = readingTime(post);
---

<li class="card">
  <a href={`/post/${post.id}/`}>
    <div class="strip">
      <span class="ordinal">
        <span aria-hidden="true">&gt; </span>POST #{String(number).padStart(2, '0')}
        {post.data.draft && <span class="draft">[RASCUNHO]</span>}
      </span>
      <span class="minutes">{minutes} MIN READ</span>
    </div>

    <div class="body">
      <TagList tags={post.data.tags} maxTags={3} variant="terminal" />

      <h2>{post.data.title}</h2>

      <p>{excerpt(post)}</p>

      <div class="footer">
        <time datetime={post.data.pubDate.toISOString()}>{isoDate(post.data.pubDate)}</time>
        <span class="cue" aria-hidden="true">
          LER POST &gt;
        </span>
      </div>
    </div>
  </a>
</li>

<style>
  /* TagList's terminal chips are styled from here, anchored under .card, so TagList
     itself needs no scoped block and post pages stay free of this CSS. */
  .card :global(.chips) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .card :global(.chip) {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--color-green) 45%, transparent);
    background: color-mix(in srgb, var(--color-green) 8%, transparent);
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-green) 80%, black);
    white-space: nowrap;
  }

  .card :global(.caret) {
    margin-right: 0.25rem;
    opacity: 0.6;
  }

  .card :global(.overflow) {
    border-style: dashed;
  }

  .card {
    display: flex;
    background: #fdfdfb;
    border: 1px solid color-mix(in srgb, var(--color-green) 55%, transparent);
    /* The lift is transform-only so a hovered card never resizes its row. */
    transition:
      transform 120ms ease-out,
      box-shadow 120ms ease-out,
      border-color 120ms ease-out;
  }

  .card > a {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-green) 30%, transparent);
    background: color-mix(in srgb, var(--color-green) 7%, transparent);
    padding: 0.4rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-green) 75%, black);
  }

  .draft {
    margin-left: 0.375rem;
    color: #b45309;
  }

  .minutes {
    white-space: nowrap;
    opacity: 0.75;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.875rem 0.75rem 0.625rem;
  }

  h2 {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
    color: #2f3a33;
    transition: color 120ms ease-out;
  }

  p {
    margin-top: 0.5rem;
    margin-bottom: 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  /* margin-top:auto pins the footer to the bottom so cards of differing title and
     tag lengths line up across a row. */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-green) 35%, transparent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-green) 70%, black);
  }

  .footer time {
    opacity: 0.8;
  }

  .card:hover,
  .card:has(a:focus-visible) {
    transform: translate(-2px, -2px);
    border-color: color-mix(in srgb, var(--color-green) 95%, black);
    box-shadow: 4px 4px 0 0 color-mix(in srgb, var(--color-green) 65%, transparent);
  }

  .card:hover h2,
  .card:has(a:focus-visible) h2 {
    color: var(--color-green);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: border-color 120ms ease-out;
    }

    .card:hover,
    .card:has(a:focus-visible) {
      transform: none;
      box-shadow: none;
    }
  }
</style>

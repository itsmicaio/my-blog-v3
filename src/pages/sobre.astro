---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="Sobre" description={`Sobre ${SITE.author}.`}>
  <h1 class="text-3xl font-semibold tracking-tight">Sobre</h1>
  <p class="text-ink-muted mt-4 leading-relaxed">
    Em breve. Este é o esqueleto da v3 do blog — substitua por sua bio.
  </p>
</BaseLayout>

---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts, type Post } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
};

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="border-edge mb-10 border-b pb-6">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{post.data.title}</h1>
      <p class="text-ink-muted mt-3 text-lg">{post.data.description}</p>
      <div class="text-ink-muted mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>· atualizado em {formatDate(post.data.updatedDate)}</span>}
        {post.data.tags.map((tag) => (
          <span class="bg-surface-muted rounded-full px-2 py-0.5">{tag}</span>
        ))}
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>
  </article>

  <a href="/blog" class="text-accent mt-12 inline-block text-sm hover:underline">
    ← Voltar para o blog
  </a>
</BaseLayout>

<style>
  .post-body {
    line-height: 1.75;
  }
  .post-body :global(h2) {
    margin-block: 2.5rem 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .post-body :global(h3) {
    margin-block: 2rem 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .post-body :global(p) {
    margin-block: 1rem;
  }
  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-block: 1rem;
    padding-inline-start: 1.5rem;
  }
  .post-body :global(ul) {
    list-style: disc;
  }
  .post-body :global(ol) {
    list-style: decimal;
  }
  .post-body :global(li + li) {
    margin-block-start: 0.25rem;
  }
  .post-body :global(blockquote) {
    margin-block: 1.5rem;
    border-inline-start: 2px solid var(--color-edge);
    padding-inline-start: 1rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }
  .post-body :global(pre) {
    margin-block: 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--color-edge);
    border-radius: 0.5rem;
    padding: 1rem;
    font-size: 0.875rem;
  }
  .post-body :global(:not(pre) > code) {
    background: var(--color-surface-muted);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .post-body :global(img) {
    margin-block: 1.5rem;
    border-radius: 0.5rem;
  }
</style>

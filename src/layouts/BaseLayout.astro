---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../styles/content.css';
import { SITE } from '../consts';
import SiteHeader from '../components/SiteHeader.astro';
import { SHARE_IMAGE_HEIGHT, SHARE_IMAGE_WIDTH } from '../lib/share-image';

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image; a page without one of its own gets the site default. */
  image?: { src: string; alt: string };
  type?: 'website' | 'article';
  /** v2's linktree page has its own full-bleed chrome instead of the site header. */
  bare?: boolean;
}

const {
  title,
  description = SITE.description,
  image = { src: '/og/site.png', alt: `${SITE.title} — ${SITE.tagline}` },
  type = 'website',
  bare = false,
} = Astro.props;
const pageTitle = title ?? SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview crawlers do not resolve relative references, so the image URL is absolute.
const imageUrl = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-space-mono" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(SHARE_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}
    ></script>
    <script is:inline define:vars={{ measurementId: SITE.gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // gtag.js reads an Arguments object off dataLayer; rest params would
        // push a plain Array and the hit would be dropped.
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>
  </head>
  <body class="text-gray-600">
    {!bare && <SiteHeader />}
    <slot />
  </body>
</html>

---
import '../styles/global.css';
import '../styles/content.css';
import { SITE, SOCIAL_LINKS } from '../consts';
import SocialIcon from '../components/SocialIcon.astro';

interface Props {
  title?: string;
  description?: string;
  /** v2's linktree page has its own full-bleed chrome instead of the site header. */
  bare?: boolean;
}

const { title, description = SITE.description, bare = false } = Astro.props;
const pageTitle = title ?? SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}
    ></script>
    <script is:inline define:vars={{ measurementId: SITE.gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // gtag.js reads an Arguments object off dataLayer; rest params would
        // push a plain Array and the hit would be dropped.
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', measurementId);
    </script>
  </head>
  <body class="text-gray-600">
    {!bare && (
      <>
        <header class="bg-green fixed top-0 left-0 flex w-full flex-col items-center shadow-md">
          <a class="mt-1 flex items-center justify-center gap-3" href="/">
            <img
              class="h-14 w-14 rounded-full border-[1px] border-solid border-white"
              src={SITE.avatar}
              alt={`Avatar ${SITE.author}`}
              width="56"
              height="56"
            />
            <span class="max-w-xs text-2xl text-white">{SITE.author}</span>
          </a>
          <div class="my-2 flex w-full max-w-sm justify-between px-3 text-white">
            {SOCIAL_LINKS.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="flex">
                <SocialIcon name={link.icon} class="mr-1 h-4 w-4 self-center" />
                {link.label}
              </a>
            ))}
          </div>
        </header>
        {/* Spacer matching the fixed header's height so content is never hidden. */}
        <div class="h-28" />
      </>
    )}
    <slot />
  </body>
</html>
